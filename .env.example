# Vercel build-time variable: public Render backend URL.
VITE_API_URL=http://localhost:8000

# Render backend runtime variables.
APP_ENV=production
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Copy this from Supabase Dashboard > Connect > Transaction pooler.
# URL-encode special characters in YOUR_DB_PASSWORD.
SUPABASE_DB_URL=postgresql+psycopg2://postgres.ggtwjjkgwscddunoswlr:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Set this to the deployed Vercel URL, for example:
# FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

GROQ_API_KEY=YOUR_GROQ_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
